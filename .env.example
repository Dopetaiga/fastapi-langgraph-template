# Environment variable template
app_name=fastapi-langgraph-template
debug=false
database_url=postgresql+asyncpg://agent:agent@localhost:5432/agent_runtime
litellm_api_base=http://localhost:4000
litellm_api_key=sk-litellm
model_name=gpt-4o-mini
model_capabilities={"gpt-4o-mini":["tools","structured_output"],"claude-3-5-haiku-latest":["tools","structured_output"]}
model_call_num_retries=0
litellm_master_key=sk-litellm
openai_api_key=
anthropic_api_key=
mem0_enabled=false
mem0_api_key=
mem0_data_dir=.runtime/mem0
mcp_endpoints=[]
openapi_urls=[]
otel_enabled=true
otel_service_name=agent-runtime
otel_exporter_otlp_endpoint=http://localhost:4317
otel_insecure=true
otel_metrics_export_interval_ms=15000
log_level=INFO
log_json=true
